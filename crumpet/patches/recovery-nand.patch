 #include "progresstracking.hpp"
 
 using namespace std;
+
+#ifdef TW_CRUMPET_NAND
+// These scripts dispatch only to the NAND/UBI backends, never dd to a volume.
+static bool CrumpetRun(const char* script, const string& label, const string& filename) {
+    pid_t pid = fork();
+    if (pid < 0) return false;
+    if (pid == 0) {
+        execl("/sbin/sh", "sh", script, label.c_str(), filename.c_str(), (char*)NULL);
+        _exit(127);
+    }
+    int status;
+    while (waitpid(pid, &status, 0) < 0) {
+        if (errno != EINTR) return false;
+    }
+    return WIFEXITED(status) && WEXITSTATUS(status) == 0;
+}
+
+static string CrumpetImageLabel(const string& mount) {
+    if (mount == "/boot_a" || mount == "/boot_b") return mount.substr(1);
+    if (mount == "/system_a_image") return "system_a";
+    if (mount == "/system_b_image") return "system_b";
+    return "";
+}
+
+static unsigned long long CrumpetVolumeSize(const string& path) {
+    char resolved[PATH_MAX], extra;
+    int ubi, volume, consumed = 0;
+    if (!realpath(path.c_str(), resolved) ||
+        sscanf(resolved, "/dev/ubi%d_%d%n", &ubi, &volume, &consumed) != 2 || resolved[consumed]) return 0;
+    char attr[PATH_MAX];
+    snprintf(attr, sizeof(attr), "/sys/class/ubi/ubi%d_%d/data_bytes", ubi, volume);
+    FILE* stream = fopen(attr, "r");
+    if (!stream) return 0;
+    unsigned long long size = 0;
+    if (fscanf(stream, "%llu %c", &size, &extra) != 1) size = 0;
+    fclose(stream);
+    return size;
+}
+#endif
+
 
