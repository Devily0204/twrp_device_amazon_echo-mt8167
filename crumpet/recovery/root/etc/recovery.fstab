# crumpet-storage.sh --init resolves these names after UBI attach.
# Requires crumpet/patches/recovery-nand.patch in the recovery core.
/system_root squashfs /dev/block/current-system flags=display="System";backup=1;canbewiped=0;wipeingui=0;fsflags=ro
/system_a squashfs /dev/block/crumpet/system_a flags=display="System A";backup=1;canbewiped=0;wipeingui=0;fsflags=ro
/system_b squashfs /dev/block/crumpet/system_b flags=display="System B";backup=1;canbewiped=0;wipeingui=0;fsflags=ro

# Image restores use UBI_IOCVOLUP, never dd/pwrite on UBI character devices.
/system_a_image emmc /dev/crumpet/ubi/system_a flags=display="System A image";backup=1;flashimg=1
/system_b_image emmc /dev/crumpet/ubi/system_b flags=display="System B image";backup=1;flashimg=1
/boot_a mtd boot_a flags=display="Boot A";backup=1;flashimg=1
/boot_b mtd boot_b flags=display="Boot B";backup=1;flashimg=1

# File wipes preserve the UBI volume table and all filesystem geometry.
/data ubifs /dev/crumpet/ubi/userdata flags=display="Data";backup=1;usermrf=1;wipeingui=1;wipeduringfactoryreset=1;ignoreblkid
/cache ubifs /dev/crumpet/ubi/cache flags=display="Cache";backup=1;usermrf=1;wipeingui=1;wipeduringfactoryreset=1;ignoreblkid
/persist ubifs /dev/crumpet/ubi/persist flags=display="Persist";backup=1;canbewiped=0;fsflags=ro;ignoreblkid

/usb-otg vfat /dev/block/platform/mt_usb/sda1 /dev/block/platform/mt_usb/sda flags=display="USB-OTG";storage;removable;canbewiped=0;wipeingui=0
