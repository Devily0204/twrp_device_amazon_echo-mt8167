import /init.recovery.led-service.rc

on init
    write /sys/devices/platform/mt_usb/cmode 1

    symlink /dev/block/platform/soc/11120000.mmc/by-name /dev/block/by-name
    symlink /dev/block/platform/soc/11120000.mmc /dev/block/platform/mtk-msdc.0

on fs
    symlink /dev/block/platform/soc/11120000.mmc /dev/block/platform/bootdevice

    wait /dev/block/platform/bootdevice/by-name/userdata

    exec u:r:recovery:s0 root root -- /sbin/sh /sbin/e2fsck-data.sh

    symlink /dev/block/platform/soc/11120000.mmc/by-name/swdl /dev/block/platform/soc/11120000.mmc/by-name/recovery

    exec u:r:recovery:s0 root root -- /sbin/sh /sbin/slot-symlinks.sh

on boot
    exec u:r:recovery:s0 root root -- /sbin/sh /sbin/bcbfix

on property:amonet.preloader=rw
    write /sys/block/mmcblk0boot0/force_ro 0

on property:amonet.preloader=ro
    write /sys/block/mmcblk0boot0/force_ro 1
