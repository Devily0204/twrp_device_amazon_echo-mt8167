+#!/sbin/sh
+# Explicit Android command/status/recovery record I/O. Never run during startup.
+# Resolve the stock rolling NAND record; never consume stale --wipe_data commands.
+set -eu
+PATH=/sbin:/system/bin:$PATH
+device=$(readlink -f /dev/crumpet/mtd/misc)
+[ "$#" -ge 1 ] || exit 2
+case "$1" in
+    backup)
+        [ "$#" = 2 ] || exit 2
+        crumpet-mtd bcb-read "$device" "$2"
+        sha256sum "$2"
+        ;;
+    clear|restore)
+        temp=$(mktemp -d /tmp/crumpet-bcb.XXXXXX)
+        trap 'rm -f "$temp/record"; rmdir "$temp"' EXIT
+        if [ "$1" = clear ]; then
+            [ "$#" = 1 ] || exit 2
+            dd if=/dev/zero of="$temp/record" bs=832 count=1 2>/dev/null
+        else
+            [ "$#" = 3 ] && [ "$(wc -c < "$2")" = 832 ] || exit 2
+            hash=$(sha256sum "$2"); hash=${hash%% *}
+            [ "$hash" = "$3" ] || { echo "BCB record SHA256 mismatch" >&2; exit 1; }
+            cp "$2" "$temp/record"
+        fi
+        crumpet-mtd bcb-write "$device" "$temp/record"
+        ;;
+    status)
+        [ "$#" = 1 ] || exit 2
+        crumpet-mtd bcb-status "$device"
+        ;;
+    activate|mark-success)
+        [ "$#" = 2 ] || exit 2
+        case "$2" in a|b) ;; *) exit 2 ;; esac
+        if [ "$1" = mark-success ]; then
+            [ "$(getprop ro.boot.slot_suffix)" = "_$2" ] || exit 1
+            crumpet-mtd bcb-success "$device" "$2"
+        else
+            crumpet-mtd bcb-activate "$device" "$2"
+        fi
+        ;;
+    *) echo "Usage: crumpet-bcb.sh status | backup FILE | clear | restore FILE SHA256 | activate a|b | mark-success a|b" >&2; exit 2 ;;
+esac
diff --git a/crumpet/recovery/root/sbin/crumpet-flash.sh b/crumpet/recovery/root/sbin/crumpet-flash.sh
new file mode 100755
index 0000000..66cb076
--- /dev/null
+++ b/crumpet/recovery/root/sbin/crumpet-flash.sh
@@ -0,0 +1,41 @@
+#!/sbin/sh
+set -eu
+root=${CRUMPET_STORAGE_ROOT:-}
+PATH="${root}/sbin:/sbin:/system/bin:${PATH}"
+[ "$#" -ge 2 ] && [ "$#" -le 3 ] || { echo "Usage: crumpet-flash.sh TARGET IMAGE [SHA256]" >&2; exit 2; }
+target=$1
+image=$2
+[ -f "$image" ] || exit 2
+hash=$(sha256sum "$image"); hash=${hash%% *}
+if [ "$#" = 3 ]; then
+    [ "${#3}" = 64 ] || exit 2
+    case "$3" in *[!0-9a-f]*) exit 2 ;; esac
+    [ "$hash" = "$3" ] || { echo "Image SHA256 mismatch" >&2; exit 1; }
+fi
+
+case "$target" in
+    boot_a|boot_b|system_a|system_b)
+        slot=$(getprop ro.boot.slot_suffix)
+        case "$slot" in _a|_b) ;; *) echo "Unknown active slot" >&2; exit 1 ;; esac
+        [ "_${target##*_}" != "$slot" ] || { echo "Refusing to overwrite active slot" >&2; exit 1; }
+        ;;
+    userdata|cache) ;;
+    *) echo "Unsupported image target" >&2; exit 2 ;;
+esac
+
+case "$target" in
+    boot_a|boot_b)
+        [ "$(dd if="$image" bs=8 count=1 2>/dev/null)" = 'ANDROID!' ] || { echo "Not an Android boot image" >&2; exit 1; }
+        bytes=$(wc -c < "$image")
+        [ "$bytes" -ge 2048 ] && [ "$bytes" -le 15990784 ] || exit 1
+        device=$(readlink -f "${root}/dev/crumpet/mtd/${target}")
+        [ "$(cat "${root}/sys/class/mtd/${device##*/}/name")" = "$target" ] || { echo "MTD alias points to another partition" >&2; exit 1; }
+        "${root}/sbin/crumpet-mtd" write "$device" 0 "$image"
+        ;;
+    *)
+        device=$(readlink -f "${root}/dev/crumpet/ubi/${target}")
+        [ "$(cat "${root}/sys/class/ubi/${device##*/}/name")" = "$target" ] || { echo "UBI alias points to another volume" >&2; exit 1; }
+        "${root}/sbin/crumpet-ubi" update "$device" "$image"
+        ;;
+esac
+echo "$target: source SHA256 $hash; device readback verified"
