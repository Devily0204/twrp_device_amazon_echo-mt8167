new file mode 100644
index 0000000000000000000000000000000000000000..0b05a01c154c125b00a61c26b9e7c838f5a645de
--- /dev/null
+++ b/tests/test_mtd.c
@@ -0,0 +1,183 @@
+// Production RMW algorithm, with only the MTD syscalls replaced by a NAND model.
+#undef NDEBUG
+#include <assert.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <setjmp.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+static int model_open(const char*, int, ...);
+static int model_ioctl(int, unsigned long, void*);
+static ssize_t model_read(int, void*, size_t);
+static ssize_t model_write(int, const void*, size_t);
+static off_t model_seek(int, off_t, int);
+static int model_close(int);
+static int model_sync(int);
+static void model_exit(int);
+#define CRUMPET_NAND_TEST
+#define LOCK_EX 2
+#define LOCK_NB 4
+#define flock(fd, flags) (0)
+#define open(...) model_open(__VA_ARGS__)
+#define ioctl(...) model_ioctl(__VA_ARGS__)
+#define read(...) model_read(__VA_ARGS__)
+#define write(...) model_write(__VA_ARGS__)
+#define lseek(...) model_seek(__VA_ARGS__)
+#define close(...) model_close(__VA_ARGS__)
+#define fsync(...) model_sync(__VA_ARGS__)
+#define exit(...) model_exit(__VA_ARGS__)
+#define main crumpet_mtd_program_main
+#include "../crumpet/nand/crumpet-mtd.c"
+#undef main
+#undef exit
+
+enum { ERASE = 262144, CAPACITY = 8 * ERASE };
+static unsigned char nand_data[CAPACITY], before[CAPACITY];
+static size_t position;
+static int erases, bad_block, interrupt_read, interrupt_write, corrupt_readback, wrote, fail_write;
+static jmp_buf failure;
+static int exit_status;
+
+static int model_open(const char* path, int flags, ...) { (void)path; (void)flags; return 100; }
+static int model_close(int fd) { assert(fd == 100); return 0; }
+static int model_sync(int fd) { assert(fd == 100); return 0; }
+static void model_exit(int code) { exit_status = code; longjmp(failure, 1); }
+
+static int model_ioctl(int fd, unsigned long command, void* arg) {
+    assert(fd == 100);
+    if (command == MEMGETINFO) {
+        struct mtd_info_user* info = arg;
+        *info = (struct mtd_info_user){.type=4, .size=CAPACITY, .erasesize=ERASE, .writesize=4096, .oobsize=256};
+        return 0;
+    }
+    if (command == MEMGETBADBLOCK) return (int)(*(uint64_t*)arg / ERASE) == bad_block;
+    assert(command == MEMERASE);
+    struct erase_info_user* range = arg;
+    assert(range->start % ERASE == 0 && range->length % ERASE == 0);
+    assert(range->start + range->length <= CAPACITY);
+    for (size_t block = range->start; block < range->start + range->length; block += ERASE)
+        assert((int)(block / ERASE) != bad_block);
+    memset(nand_data + range->start, 255, range->length);
+    erases += range->length / ERASE;
+    return 0;
+}
+
+static off_t model_seek(int fd, off_t offset, int mode) {
+    assert(fd == 100 && mode == SEEK_SET && offset >= 0 && offset <= CAPACITY);
+    position = (size_t)offset;
+    return offset;
+}
+
+static ssize_t model_read(int fd, void* out, size_t length) {
+    assert(fd == 100);
+    if (interrupt_read) { interrupt_read = 0; errno = EINTR; return -1; }
+    if (length > 8192) length = 8192;
+    assert(position + length <= CAPACITY);
+    memcpy(out, nand_data + position, length);
+    if (corrupt_readback && wrote && length) ((unsigned char*)out)[0] ^= 1;
+    position += length;
+    return (ssize_t)length;
+}
+
+static ssize_t model_write(int fd, const void* input, size_t length) {
+    assert(fd == 100);
+    if (interrupt_write) { interrupt_write = 0; errno = EINTR; return -1; }
+    if (fail_write) { errno = EIO; return -1; }
+    if (length > 4096) length = 4096;
+    assert(position % 4096 == 0 && length % 4096 == 0 && position + length <= CAPACITY);
+    const unsigned char* data = input;
+    for (size_t i = 0; i < length; i++) {
+        assert((nand_data[position+i] & data[i]) == data[i]);
+        nand_data[position+i] = data[i];
+    }
+    position += length;
+    wrote = 1;
+    return (ssize_t)length;
+}
+
+static void reset_model(void) {
+    for (size_t i=0; i<CAPACITY; i++) nand_data[i] = (unsigned char)(i * 31 + i / 4096);
+    memcpy(before, nand_data, CAPACITY);
+    position=0; erases=0; bad_block=-1; interrupt_read=0; interrupt_write=0;
+    corrupt_readback=0; wrote=0; fail_write=0; exit_status=0;
+}
+
+static void input_file(const char* path, size_t size, unsigned char value) {
+    FILE* f = fopen(path, "wb");
+    assert(f);
+    for (size_t i=0;i<size;i++) assert(fputc(value,f) != EOF);
+    assert(fclose(f) == 0);
+}
+
+int main(int argc, char** argv) {
+    assert(argc == 2);
+    const char* image = argv[1];
+    reset_model(); input_file(image,832,0);
+    interrupt_read=1; interrupt_write=1;
+    cmd_write("memory",0,image,1);
+    assert(erases==1 && !memcmp(nand_data+832,before+832,CAPACITY-832));
+    for (size_t i=0;i<832;i++) assert(nand_data[i]==0);
+    assert(!memcmp(nand_data+0x360,before+0x360,7));
+
+    reset_model(); input_file(image,8192,42);
+    cmd_write("memory",ERASE-4096,image,1);
+    assert(erases==2 && !memcmp(nand_data,before,ERASE-4096));
+    assert(!memcmp(nand_data+ERASE+4096,before+ERASE+4096,CAPACITY-ERASE-4096));
+    for(size_t i=ERASE-4096;i<ERASE+4096;i++) assert(nand_data[i]==42);
+
+    reset_model(); input_file(image,2*ERASE,77); bad_block=1;
+    if (!setjmp(failure)) { cmd_write("memory",0,image,1); assert(0); }
+    assert(exit_status && erases==0 && !memcmp(nand_data,before,CAPACITY));
+
+    reset_model(); input_file(image,4096,9); corrupt_readback=1;
+    if (!setjmp(failure)) { cmd_write("memory",0,image,1); assert(0); }
+    assert(exit_status && erases==1);
+
+    reset_model(); input_file(image,4096,9); fail_write=1;
+    if (!setjmp(failure)) { cmd_write("memory",0,image,1); assert(0); }
+    assert(exit_status && erases==1);
+
+    reset_model(); input_file(image,4096,9);
+    if (!setjmp(failure)) { cmd_write("memory",CAPACITY-2048,image,1); assert(0); }
+    assert(exit_status && erases==0 && !memcmp(nand_data,before,CAPACITY));
+
+    // Real backups carry exactly this header in different nonzero RR blocks.
+    reset_model(); memset(nand_data,255,CAPACITY);
+    memset(nand_data+7*ERASE,0,ERASE);
+    memcpy(nand_data+7*ERASE+0x360,"\0ABB\1\x8f\x8e\0",8);
+    memcpy(before,nand_data,CAPACITY);
+    cmd_bcb("bcb-activate","memory","b");
+    assert(erases==2 && !memcmp(nand_data+0x360,"\0ABB\1\x8e\x7f\0",8));
+    for(size_t i=7*ERASE;i<CAPACITY;i++) assert(nand_data[i]==255);
+    assert(!memcmp(nand_data,before+7*ERASE,0x365));
+    assert(!memcmp(nand_data+0x367,before+7*ERASE+0x367,ERASE-0x367));
+    cmd_bcb("bcb-success","memory","b");
+    assert(!memcmp(nand_data+ERASE+0x360,"\0ABB\1\x8e\x8f\0",8));
+
+    // Failure before publishing the first page leaves the old record selected.
+    reset_model(); memset(nand_data,255,CAPACITY);
+    memset(nand_data+7*ERASE,0,ERASE);
+    memcpy(nand_data+7*ERASE+0x360,"\0ABB\1\x8f\x8e\0",8);
+    memcpy(before,nand_data,CAPACITY); fail_write=1;
+    if (!setjmp(failure)) { cmd_bcb("bcb-activate","memory","b"); assert(0); }
+    assert(exit_status && erases==1);
+    assert(!memcmp(nand_data+7*ERASE,before+7*ERASE,ERASE));
+    for(size_t i=0;i<4096;i++) assert(nand_data[i]==255);
+
+    // An unknown/empty misc partition is never initialized by guessing.
+    reset_model(); memset(nand_data,255,CAPACITY);
+    if (!setjmp(failure)) { cmd_bcb("bcb-activate","memory","b"); assert(0); }
+    assert(exit_status && erases==0);
+
+    reset_model();
+    for(int i=0;i<8;i++) memcpy(nand_data+i*ERASE+0x360,"\0ABB\1",5);
+    if (!setjmp(failure)) { cmd_bcb("bcb-activate","memory","b"); assert(0); }
+    assert(exit_status && erases==0);
+    puts("MTD model: partial/cross-block RMW, preserved metadata, bad-block preflight, EINTR, short I/O, verification and failure cases passed");
+    return 0;
+}
diff --git a/tools/inspect_crumpet_bcb.py b/tools/inspect_crumpet_bcb.py
new file mode 100644
index 0000000000000000000000000000000000000000..4281cb8d306009d329b099e7a7b8ba396df2687b
--- /dev/null
+++ b/tools/inspect_crumpet_bcb.py
@@ -0,0 +1,23 @@
+"""Inspect the stock eraseblock-aligned redundant BCB records in a misc backup."""
+import argparse
+import json
+from pathlib import Path
+
+
+def records(path):
+    found = []
+    with path.open("rb") as stream:
+        for block in range(8):
+            stream.seek(block * 262144 + 0x360)
+            metadata = stream.read(8)
+            if metadata[:5] != b"\0ABB\1":
+                continue
+            slots = [{"priority": b & 15, "tries": (b >> 4) & 7, "successful": bool(b & 128)} for b in metadata[5:7]]
+            found.append({"block": block, "offset": block * 262144, "metadata": metadata.hex(), "slots": slots})
+    return found
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("misc", type=Path)
+    print(json.dumps(records(parser.parse_args().misc), indent=2))
diff --git a/tools/prepare_crumpet_ota.py b/tools/prepare_crumpet_ota.py
new file mode 100644
index 0000000000000000000000000000000000000000..b2dad06baf44737799d1abf692970c4c076ee078
--- /dev/null
+++ b/tools/prepare_crumpet_ota.py
@@ -0,0 +1,199 @@
+"""Verify/extract boot+system from a trusted full Crumpet OTA into an inactive-slot plan.
+
+Requires an independently trusted whole-ZIP SHA256. This does not establish a
+new signer trust chain, install bootchain partitions, or activate a boot slot.
+"""
+import argparse
+import bz2
+import hashlib
+import json
+import lzma
+from pathlib import Path
+import struct
+import tempfile
+import zipfile
+
+
+def require(condition, message):
+    if not condition:
+        raise ValueError(message)
+
+
+def digest(stream, length=None):
+    h = hashlib.sha256()
+    while length is None or length:
+        block = stream.read(1024 * 1024 if length is None else min(length, 1024 * 1024))
+        if not block:
+            require(length in (None, 0), "Truncated input while hashing")
+            break
+        h.update(block)
+        if length is not None:
+            length -= len(block)
+    return h.digest()
+
+
+def varint(blob, offset):
+    value = 0
+    for shift in range(0, 70, 7):
+        require(offset < len(blob), "Truncated protobuf varint")
+        byte = blob[offset]
+        offset += 1
+        value |= (byte & 127) << shift
+        if not byte & 128:
+            require(value < 1 << 64, "Protobuf integer overflow")
+            return value, offset
+    raise ValueError("Oversized protobuf varint")
+
+
+def fields(blob):
+    """Read only standard protobuf wire types used by update_metadata.proto."""
+    offset, result = 0, {}
+    while offset < len(blob):
+        tag, offset = varint(blob, offset)
+        field, wire = tag >> 3, tag & 7
+        require(field > 0, "Invalid protobuf field")
+        if wire == 0:
+            value, offset = varint(blob, offset)
+        elif wire in (1, 2, 5):
+            if wire == 2:
+                length, offset = varint(blob, offset)
+            else:
+                length = 8 if wire == 1 else 4
+            require(length <= len(blob) - offset, "Truncated protobuf field")
+            value = blob[offset:offset + length]
+            offset += length
+        else:
+            raise ValueError("Unsupported protobuf wire type")
+        result.setdefault(field, []).append(value)
+    return result
+
+
+def one(message, field, default=None):
+    values = message.get(field, [])
+    require(len(values) <= 1, "Duplicate singular protobuf field")
+    return values[0] if values else default
+
+
+def payload_manifest(stream):
+    header = stream.read(24)
+    require(len(header) == 24 and header[:4] == b"CrAU", "Invalid payload header")
+    major, length, signature_length = struct.unpack(">QQI", header[4:])
+    require(major == 2 and 0 < length <= 32 * 1024 * 1024, "Unsupported payload version/manifest size")
+    require(signature_length <= 1024 * 1024, "Oversized metadata signature")
+    blob = stream.read(length)
+    require(len(blob) == length, "Truncated manifest")
+    manifest = fields(blob)
+    require(one(manifest, 12, 0) == 0, "Incremental OTA requires unsupported source/delta operations")
+    block_size = one(manifest, 3, 4096)
+    require(block_size == 4096, "Unexpected Crumpet payload block size")
+    selected = {}
+    for entry in manifest.get(13, []):
+        part = fields(entry)
+        name = one(part, 1, b"").decode("ascii")
+        if name not in ("boot", "system"):
+            continue
+        require(name not in selected, "Duplicate payload partition")
+        require(6 not in part, "Source partition data is not supported")
+        info = fields(one(part, 7, b""))
+        size, checksum = one(info, 1), one(info, 2)
+        maximum = 15990784 if name == "boot" else 136626176
+        require(isinstance(size, int) and 0 < size <= maximum, "Image exceeds verified partition capacity")
+        require(isinstance(checksum, bytes) and len(checksum) == 32, "Missing partition SHA256")
+        selected[name] = (part, size, checksum)
+    require(set(selected) == {"boot", "system"}, "OTA must contain both boot and system")
+    return selected, 24 + length + signature_length, block_size
+
+
+def extract_partition(payload, part, size, expected, data_start, block_size, output):
+    with output.open("xb+") as image:
+        image.truncate(size)
+        occupied = []
+        for raw in part.get(8, []):
+            operation = fields(raw)
+            kind = one(operation, 1)
+            require(kind in (0, 1, 6, 7, 8), "Unsupported delta/source operation")
+            require(4 not in operation and 9 not in operation, "Source-copy/delta operation is not supported")
+            extents = []
+            for raw_extent in operation.get(6, []):
+                extent = fields(raw_extent)
+                start, count = one(extent, 1), one(extent, 2)
+                require(isinstance(start, int) and isinstance(count, int) and count > 0, "Invalid extent")
+                offset, length = start * block_size, count * block_size
+                require(offset < size and length <= size - offset, "Extent outside destination image")
+                require(all(offset + length <= a or b <= offset for a, b in occupied), "Overlapping extents")
+                occupied.append((offset, offset + length))
+                extents.append((offset, length))
+            amount = sum(length for _, length in extents)
+            require(0 < amount <= 64 * 1024 * 1024, "Oversized/empty operation")
+            if kind in (6, 7):
+                require(one(operation, 3, 0) == 0, "ZERO/DISCARD must not contain a data blob")
+                decoded = bytes(amount)
+            else:
+                offset, length = one(operation, 2, 0), one(operation, 3, 0)
+                require(0 < length <= 64 * 1024 * 1024, "Invalid operation data length")
+                payload.seek(data_start + offset)
+                data = payload.read(length)
+                require(len(data) == length, "Truncated operation data")
+                checksum = one(operation, 8)
+                require(isinstance(checksum, bytes) and len(checksum) == 32 and
+                        hashlib.sha256(data).digest() == checksum, "Operation SHA256 mismatch")
+                if kind == 0:
+                    decoded = data
+                else:
+                    decoder = bz2.BZ2Decompressor() if kind == 1 else lzma.LZMADecompressor()
+                    decoded = decoder.decompress(data, max_length=amount + 1)
+                    require(decoder.eof and not decoder.unused_data, "Invalid compressed operation")
+                require(len(decoded) <= amount, "Operation expands past its destination")
+                decoded += bytes(amount - len(decoded))
+            offset = 0
+            for destination, length in extents:
+                image.seek(destination)
+                image.write(decoded[offset:offset + length])
+                offset += length
+        occupied.sort()
+        cursor = 0
+        for start, end in occupied:
+            require(start == cursor, "Payload leaves an unspecified image range")
+            cursor = end
+        require(cursor == size, "Payload does not cover complete partition image")
+        image.seek(0)
+        require(digest(image, size) == expected, "Final partition SHA256 mismatch")
+        image.seek(0)
+        magic = image.read(8)
+        require(magic == b"ANDROID!" if output.stem == "boot" else magic[:4] == b"hsqs",
+                "Extracted image has the wrong filesystem/boot magic")
+
+
+def prepare(ota, expected_sha256, output, slot):
+    require(slot in ("a", "b"), "Invalid target slot")
+    require(len(expected_sha256) == 64 and all(c in "0123456789abcdef" for c in expected_sha256), "Invalid trusted ZIP hash")
+    with ota.open("rb") as stream:
+        require(digest(stream).hex() == expected_sha256, "Whole OTA ZIP SHA256 mismatch")
+    require(not output.exists(), "Output directory already exists")
+    output.parent.mkdir(parents=True, exist_ok=True)
+    with zipfile.ZipFile(ota) as archive, tempfile.TemporaryDirectory(prefix="crumpet-ota-", dir=output.parent) as temp:
+        require(len(archive.namelist()) == len(set(archive.namelist())), "Duplicate ZIP entry")
+        metadata = dict(line.split("=", 1) for line in archive.read("META-INF/com/android/metadata").decode().splitlines() if "=" in line)
+        require(metadata.get("pre-device") == "crumpet" and metadata.get("ota-type") == "AB", "OTA is not for Crumpet")
+        plan = {"source_sha256": expected_sha256, "target_slot": slot, "activation": "not-performed", "images": {}}
+        with archive.open("payload.bin") as payload:
+            partitions, start, block_size = payload_manifest(payload)
+            for name in ("system", "boot"):
+                part, size, checksum = partitions[name]
+                extract_partition(payload, part, size, checksum, start, block_size, Path(temp) / (name + ".img"))
+                plan["images"][name] = {"size": size, "sha256": checksum.hex()}
+        (Path(temp) / "SHA256SUMS").write_text("".join(f'{plan["images"][name]["sha256"]}  {name}.img\n' for name in ("system", "boot")), newline="\n")
+        (Path(temp) / "target-slot").write_text(slot + "\n", newline="\n")
+        (Path(temp) / "plan.json").write_text(json.dumps(plan, indent=2) + "\n", newline="\n")
+        Path(temp).rename(output)
+    return plan
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("ota", type=Path)
+    parser.add_argument("--sha256", required=True, help="Independently trusted SHA256 of the complete OTA ZIP")
+    parser.add_argument("--slot", choices=("a", "b"), required=True, help="Inactive destination slot; checked again on-device")
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    print(json.dumps(prepare(args.ota, args.sha256, args.output, args.slot), indent=2))
