COMMON_PATH := device/amazon/mt8167-echo

include $(COMMON_PATH)/arch/$(DEVICE_ARCH).mk

BOARD_KERNEL_CMDLINE := bootopt=64S3,32N2,64N2 androidboot.selinux=permissive
BOARD_KERNEL_BASE := 0x40078000
BOARD_KERNEL_OFFSET := 0
BOARD_KERNEL_PAGESIZE := 2048
BOARD_MKBOOTIMG_ARGS := --base $(BOARD_KERNEL_BASE) --kernel_offset 0x00008000 --ramdisk_offset 0x03400000 --second_offset 0x00e80000 --tags_offset 0x07f88000
TARGET_PREBUILT_KERNEL := $(DEVICE_PATH)/prebuilts/$(DEVICE_KERNEL_IMAGE)

BOARD_FLASH_BLOCK_SIZE := 131072
BOARD_BOOTIMAGE_PARTITION_SIZE := 16777216
BOARD_RECOVERYIMAGE_PARTITION_SIZE := 33554432

TARGET_BOARD_PLATFORM := mt8167
TARGET_BOOTLOADER_BOARD_NAME := mt8167
TARGET_NO_BOOTLOADER := true

RECOVERY_VARIANT := twrp
BOARD_BUILD_SYSTEM_ROOT_IMAGE := true
TARGET_USERIMAGES_USE_EXT4 := true
TARGET_USERIMAGES_USE_F2FS := true

TARGET_RECOVERY_DEVICE_DIRS := $(COMMON_PATH) $(DEVICE_PATH)

AB_OTA_UPDATER := true
AB_OTA_PARTITIONS := boot system
PRODUCT_STATIC_BOOT_CONTROL_HAL := bootctrl_amzn
TARGET_RECOVERY_DEVICE_MODULES := update_engine_sideload

TARGET_SCREEN_WIDTH := 480
TARGET_SCREEN_HEIGHT := 480

TW_STATUS_NOTIFY := true
TW_STATUS_HOOK := /sbin/led-status.sh
TW_NO_SCREEN_UI := true
TW_INCLUDE_BCBTOOL := true

TW_INCLUDE_CRYPTO := false
TW_EXCLUDE_TWRPAPP := true
TW_EXCLUDE_SUPERSU := true

TW_NO_LEGACY_PROPS := true

RECOVERY_SDCARD_ON_DATA := true
ALLOW_MISSING_DEPENDENCIES := true
